ly supports GitHub through a GitHub App integration. GitLab and Bitbucket support are on the roadmap. The internal architecture is already provider-agnostic to support future expansion.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":2626.24}]}]}]},{"type":"ref","id":"r1aq","ref":"f9y","name":"footer / small","x":0,"y":3325.86},{"type":"ref","id":"r1ar","ref":"f79","name":"header / small","x":0,"y":0,"layoutPosition":"absolute"}]},{"type":"frame","id":"f164","name":"a.skip-link","x":16,"y":-64,"width":140.13,"height":44,"fill":"$text","cornerRadius":"$rounded-full","layout":"none","children":[{"type":"text","id":"t163","name":"Skip to content","content":"Skip to content","fill":"$literal-FFFFFF","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","underline":true,"x":16,"y":12}],"layoutPosition":"absolute"}]}],"x":11358,"y":0},{"type":"frame","id":"P1fh","name":"GH-39/A/compare-coderabbit/tablet/light","reusable":false,"theme":{"mode":"light"},"width":834,"height":3401,"clip":true,"layout":"none","children":[{"type":"frame","id":"f1fg","name":"body","x":0,"y":0,"width":834,"height":3401.39,"fill":[{"type":"gradient","gradientType":"radial","center":{"x":0,"y":0},"colors":[{"color":"$literal-DE6C301F","position":0},{"color":"$literal-00000000","position":0.26}]},{"type":"gradient","gradientType":"radial","center":{"x":1,"y":0},"colors":[{"color":"$literal-C3D7A12E","position":0},{"color":"$literal-00000000","position":0.24}]},{"type":"gradient","gradientType":"linear","rotation":180,"colors":[{"color":"$literal-FBF7F1","position":0},{"color":"$bg","position":0.42},{"color":"$literal-F2ECE2","position":1}]}],"layout":"none","children":[{"type":"frame","id":"f1ff","name":"div.site-shell","x":0,"y":0,"width":834,"height":3401.39,"clip":true,"layout":"none","children":[{"type":"fra