.11},{"type":"text","id":"tjm","name":"CodeRabbit uses their own model selectio","content":"CodeRabbit uses their own model selection. You generally cannot bring your own API keys or choose a specific model version.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1201.69},{"type":"text","id":"tjn","name":"Pricing","content":"Pricing","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":36.19,"y":1285.8},{"type":"text","id":"tjo","name":"nitpickr has no subscription fee. You pa","content":"nitpickr has no subscription fee. You pay for your own LLM API usage and whatever","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1319.99},{"type":"text","id":"tjp","name":"hosting you choose. Running locally with","content":"hosting you choose. Running locally with Docker Compose and a free HTTPS tunnel","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1346.38},{"type":"text","id":"tjq","name":"(like","content":"(like","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1372.77},{"type":"frame","id":"fjs","name":"code","x":70.63,"y":1375.25,"width":105.11,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"tjr","name":"cloudflared","content":"cloudflared","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"tjt","name":") means you mainly pay for OpenAI API ca","content":") means you mainly pay for OpenAI API calls.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":175.73,"y":1372.77},{"type":"text","id":"tju","name":"CodeRabbit uses per-seat pricing with mo","content":"CodeRabbit uses per-seat pricing with monthly or annual subscriptions. The free tier has usage limits.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1418.35},{"type":"text","id":"tjv","name":"When to choose nitpickr","content":"When to choose nitpickr","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":1502.46},{"type":"text","id":"tjw","name":"You want your code to stay on your own i","content":"You want your code to stay on your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1557.36},{"type":"text","id":"tjx","name":"You want to choose and switch AI models ","content":"You want to choose and switch AI models freely","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1583.75},{"type":"text","id":"tjy","name":"You prefer paying only for actual API us","content":"You prefer paying only for actual API usage instead of per-seat fees","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1610.14},{"type":"text","id":"tjz","name":"You value source-available software you ","content":"You value source-available software you can inspect and modify","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1636.53},{"type":"text","id":"tk0","name":"You want review configuration to live in","content":"You want review configuration to live in your repository, not a dashboard","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1662.93},{"type":"text","id":"tk1","name":"When to choose CodeRabbit","content":"When to choose CodeRabbit","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":1720.65},{"type":"text","id":"tk2","name":"You want a zero-setup experience with no","content":"You want a zero-setup experience with no infrastructure to manage","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1775.55},{"type":"text","id":"tk3","name":"You need GitLab, Bitbucket, or Azure Dev","content":"You need GitLab, Bitbucket, or Azure DevOps support today","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1801.94},{"type":"text","id":"tk4","name":"You prefer a managed SaaS with a web das","content":"You prefer a managed SaaS with a web dashboard","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1828.33},{"type":"text","id":"tk5","name":"You do not need control over which model","content":"You do