$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","x":14.39,"y":22.19}]},{"type":"frame","id":"ftl","name":"td","x":0,"y":573.69,"width":147.03,"height":69,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"ttk","name":"Setup","content":"Setup","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_55","x":14.39,"y":22.19}]},{"type":"frame","id":"ftn","name":"td","x":147.03,"y":573.69,"width":254.28,"height":69,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"ttm","name":"Docker Compose + GitHub App","content":"Docker Compose + GitHub App","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","x":14.39,"y":22.19}]},{"type":"frame","id":"ftp","name":"td","x":401.31,"y":573.69,"width":226.31,"height":69,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"tto","name":"API integration or marketplace install","content":"API integration or marketplace install","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":198.01,"x":14.4,"y":10.78}]}]},{"type":"text","id":"ttr","name":"Self-hosted vs SaaS","content":"Self-hosted vs SaaS","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":900.77},{"type":"text","id":"tts","name":"nitpickr runs on your own infrastructure","content":"nitpickr runs on your own infrastructure: a Docker Compose stack, a VPS, or Railway. Your source code is sent only to the LLM provider you configure. You control the deployment, secrets, and logs.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":955.68},{"type":"text","id":"ttt","name":"Greptile is a cloud platform. It indexes","content":"Greptile is a cloud platform. It indexes your repositories and stores that index on their servers. This enables broader codebase understanding but means your code is processed and stored externally.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1054.03},{"type":"text","id":"ttu","name":"Review approach","content":"Review approach","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":36.19,"y":1164.54},{"type":"text","id":"ttv","name":"nitpickr uses diff-first analysis: it re","content":"nitpickr uses diff-first analysis: it reviews changed files and hunks with surrounding context, repository instructions, and review memory. This keeps reviews fast and focused on the actual changes.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1198.72},{"type":"text","id":"ttw","name":"Greptile indexes the entire codebase to ","content":"Greptile indexes the entire codebase to provide deeper context about how changes relate to the rest of the project. This can catch cross-file issues but requires external indexing.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1297.08},{"type":"text","id":"ttx","name":"Model control","content":"Model control","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":36.19,"y":1407.59},{"type":"text","id":"tty","name":"nitpickr is model-agnostic. Set","content":"nitpickr is model-agnostic. Set","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1441.77},{"type":"frame","id":"fu0","name":"code","x":257.42,"y":1444.25,"width":113.75,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"ttz","name":"OPENAI_MODEL","content":"OPENAI_MODEL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"tu1","name":"and","content":"and","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":371.17,"y":1441.77},{"type":"frame","id":"fu3","name":"code","x":405.64,"y":1444.25,"width":139.67,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"tu2","name":"OPENAI_BASE_URL","content":"OPENAI_BASE_URL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"tu4","name":"to point at GPT-4,","content":"to point at GPT-4,","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":545.31,"y":1441.77},{"type":"text","id":"tu5","name":"GPT-5-mini, Claude, Gemini, or a self-ho","content":"GPT-5-mini, Claude, Gemini, or a self-hosted model. Switch models without changing","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1468.16},{"type":"text","id":"tu6","name":"your workflow.","content":"your workflow.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":36.19,"y":1494.55},{"type":"text","id":"tu7","name":"Greptile manages the model selection on ","content":"Greptile manages the model selection on their platform. You typically cannot bring your own API keys or choose a specific model version.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1540.13},{"type":"text","id":"tu8","name":"Pricing","content":"Pricing","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":36.19,"y":1624.24},{"type":"text","id":"tu9","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and whatever hosting you choose. Running locally with Docker Compose means you mainly pay for model API calls.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1658.43},{"type":"text","id":"tua","name":"Greptile offers usage-based pricing thro","content":"Greptile offers usage-based pricing through their API. Costs scale with the number of queries and the size of indexed repositories.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":1756.78},{"type":"text","id":"tub","name":"When to choose nitpickr","content":"When to choose nitpickr","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":1840.9},{"type":"text","id":"tuc","name":"You want code to stay on your own infras","content":"You want code to stay on your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1895.8},{"type":"text","id":"tud","name":"You want to choose and switch AI models ","content":"You want to choose and switch AI models freely","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1922.19},{"type":"text","id":"tue","name":"You want source-available software you c","content":"You want source-available software you can inspect","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1948.58},{"type":"text","id":"tuf","name":"You prefer paying only for actual API us","content":"You prefer paying only for actual API usage","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1974.97},{"type":"text","id":"tug","name":"Pull request review is your primary use ","content":"Pull request review is your primary use case","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":2001.36},{"type":"text","id":"tuh","name":"When to choose Greptile","content":"When to choose Greptile","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":2059.09},{"type":"text","id":"tui","name":"You need deep codebase understanding acr","content":"You need deep codebase understanding across all files","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":2113.99},{"type":"text","id":"tuj","name":"You want AI-powered search and Q&A beyon","content":"You want AI-powered search and Q&A beyond code review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":2140.38},{"type":"text","id":"tuk","name":"You prefer a managed API without running","content":"You prefer a managed API without running your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":2166.77},{"type":"text","id":"tul","name":"You need the broadest possible context f","content":"You need the broadest possible context for each review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":2193.16},{"type":"text","id":"tum","name":"Frequently asked questions","content":"Frequently asked questions","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":2250.88},{"type":"text","id":"tun","name":"What is the main difference between nitp","content":"What is the main difference between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":36.19,"y":2321.65},{"type":"text","id":"tuo","name":"nitpickr is a self-hosted, source-availa","content":"nitpickr is a self-hosted, source-available AI code reviewer focused on pull request review with model-agnostic design. Greptile is a SaaS platform focused on codebase-aware AI, offering code review as one of several API-driven features. nitpickr keeps your code on your own infrastructure, while Greptile processes code on their servers.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":2349.03},{"type":"text","id":"tup","name":"Does nitpickr index the entire codebase ","content":"Does nitpickr index the entire codebase like Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":36.19,"y":2483.26},{"type":"text","id":"tuq","name":"nitpickr currently focuses on diff-first","content":"nitpickr currently focuses on diff-first analysis: it reviews changed files and hunks with surrounding context. Full codebase indexing and semantic analysis are on the roadmap. For most pull request reviews, diff-focused analysis with repository instructions produces high-quality results.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":2510.64},{"type":"text","id":"tur","name":"Can I use nitpickr without sending code ","content":"Can I use nitpickr without sending code to a third-party server?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":36.19,"y":2644.87},{"type":"text","id":"tus","name":"Yes. nitpickr runs entirely on your infr","content":"Yes. nitpickr runs entirely on your infrastructure. Your code is sent only to the LLM provider you configure (such as OpenAI or a self-hosted model endpoint). With Greptile, your code is sent to their servers for indexing and analysis.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":2672.25},{"type":"text","id":"tut","name":"How does the pricing model differ betwee","content":"How does the pricing model differ between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":36.19,"y":2780.09},{"type":"text","id":"tuu","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and hosting. Greptile offers usage-based pricing through API access. For teams running frequent reviews, nitpickr's bring-your-own-key model often results in lower total cost.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":2807.47}]}]}]},{"type":"ref","id":"rve","ref":"f3o","name":"footer / desktop","x":0,"y":3594.55}]}]}],"x":8370,"y":0},{"type":"frame","id":"Pzx","name":"GH-39/A/compare-greptile/mobile/light","reusable":false,"theme":{"mode":"light"},"width