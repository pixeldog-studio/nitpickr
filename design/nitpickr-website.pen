ht-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1662.93},{"type":"text","id":"t1ef","name":"When to choose CodeRabbit","content":"When to choose CodeRabbit","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":1720.65},{"type":"text","id":"t1eg","name":"You want a zero-setup experience with no","content":"You want a zero-setup experience with no infrastructure to manage","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1775.55},{"type":"text","id":"t1eh","name":"You need GitLab, Bitbucket, or Azure Dev","content":"You need GitLab, Bitbucket, or Azure DevOps support today","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1801.94},{"type":"text","id":"t1ei","name":"You prefer a managed SaaS with a web das","content":"You prefer a managed SaaS with a web dashboard","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1828.33},{"type":"text","id":"t1ej","name":"You do not need control over which model","content":"You do not need control over which model is used","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":1854.72},{"type":"text","id":"t1ek","name":"Frequently asked questions","content":"Frequently asked questions","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":36.19,"y":1912.44},{