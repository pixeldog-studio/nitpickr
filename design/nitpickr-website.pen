72","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_55","x":14.39,"y":56.4}]},{"type":"frame","id":"fy6","name":"td","x":121.3,"y":870.25,"width":146.48,"height":137.44,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"ty5","name":"Docker Compose + GitHub App","content":"Docker Compose + GitHub App","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":118.18,"x":14.4,"y":45}]},{"type":"frame","id":"fy8","name":"td","x":267.78,"y":870.25,"width":111.45,"height":137.44,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"ty7","name":"API integration or marketplace install","content":"API integration or marketplace install","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":83.15,"x":14.4,"y":10.78}]}]},{"type":"text","id":"tya","name":"Self-hosted vs SaaS","content":"Self-hosted vs SaaS","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":1354.54},{"type":"text","id":"tyb","name":"nitpickr runs on your own infrastructure","content":"nitpickr runs on your own infrastructure: a Docker Compose stack, a VPS, or Railway. Your source code is sent only to the LLM provider you configure. You control the deployment, secrets, and logs.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":1409.44},{"type":"text","id":"tyc","name":"Greptile is a cloud platform. It indexes","content":"Greptile is a cloud platform. It indexes your repositories and stores that index on their servers. This enables broader codebase understanding but means your code is processed and stored externally.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":1560.58},{"type":"text","id":"tyd","name":"Review approach","content":"Review approach","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":1723.87},{"type":"text","id":"tye","name":"nitpickr uses diff-first analysis: it re","content":"nitpickr uses diff-first analysis: it reviews changed files and hunks with surrounding context, repository instructions, and review memory. This keeps reviews fast and focused on the actual changes.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":1758.05},{"type":"text","id":"tyf","name":"Greptile indexes the entire codebase to ","content":"Greptile indexes the entire codebase to provide deeper context about how changes relate to the rest of the project. This can catch cross-file issues but requires external indexing.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":1909.19},{"type":"text","id":"tyg","name":"Model control","content":"Model control","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":2072.48},{"type":"text","id":"tyh","name":"nitpickr is model-agnostic. Set","content":"nitpickr is model-agnostic. Set","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2106.66},{"type":"frame","id":"fyj","name":"code","x":240.63,"y":2109.14,"width":113.75,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"tyi","name":"OPENAI_MODEL","content":"OPENAI_MODEL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"tyk","name":"and","content":"and","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2133.05},{"type":"frame","id":"fym","name":"code","x":50.09,"y":2135.53,"width":139.67,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"tyl","name":"OPENAI_BASE_URL","content":"OPENAI_BASE_URL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"tyn","name":"to point at GPT-4,","content":"to point at GPT-4,","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":189.77,"y":2133.05},{"type":"text","id":"tyo","name":"GPT-5-mini, Claude, Gemini, or a self-ho","content":"GPT-5-mini, Claude, Gemini, or a self-hosted","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2159.44},{"type":"text","id":"typ","name":"model. Switch models without changing yo","content":"model. Switch models without changing your","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2185.83},{"type":"text","id":"tyq","name":"workflow.","content":"workflow.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2212.22},{"type":"text","id":"tyr","name":"Greptile manages the model selection on ","content":"Greptile manages the model selection on their platform. You typically cannot bring your own API keys or choose a specific model version.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":2257.8},{"type":"text","id":"tys","name":"Pricing","content":"Pricing","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":2368.3},{"type":"text","id":"tyt","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and whatever hosting you choose. Running locally with Docker Compose means you mainly pay for model API calls.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":2402.49},{"type":"text","id":"tyu","name":"Greptile offers usage-based pricing thro","content":"Greptile offers usage-based pricing through their API. Costs scale with the number of queries and the size of indexed repositories.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":2553.63},{"type":"text","id":"tyv","name":"When to choose nitpickr","content":"When to choose nitpickr","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":2664.13},{"type":"text","id":"tyw","name":"You want code to stay on your own infras","content":"You want code to stay on your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":2719.03},{"type":"text","id":"tyx","name":"You want to choose and switch AI models ","content":"You want to choose and switch AI models freely","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":2771.82},{"type":"text","id":"tyy","name":"You want source-available software you c","content":"You want source-available software you can inspect","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":2824.6},{"type":"text","id":"tyz","name":"You prefer paying only for actual API us","content":"You prefer paying only for actual API usage","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2877.38},{"type":"text","id":"tz0","name":"Pull request review is your primary use ","content":"Pull request review is your primary use case","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2903.77},{"type":"text","id":"tz1","name":"When to choose Greptile","content":"When to choose Greptile","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":2961.49},{"type":"text","id":"tz2","name":"You need deep codebase understanding acr","content":"You need deep codebase understanding across all files","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":3016.39},{"type":"text","id":"tz3","name":"You want AI-powered search and Q&A beyon","content":"You want AI-powered search and Q&A beyond code review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":3069.18},{"type":"text","id":"tz4","name":"You prefer a managed API without running","content":"You prefer a managed API without running your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":3121.96},{"type":"text","id":"tz5","name":"You need the broadest possible context f","content":"You need the broadest possible context for each review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":316.53,"x":38.58,"y":3174.74},{"type":"text","id":"tz6","name":"Frequently asked questions","content":"Frequently asked questions","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":3258.85},{"type":"text","id":"tz7","name":"What is the main difference between nitp","content":"What is the main difference between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3329.62},{"type":"text","id":"tz8","name":"nitpickr is a self-hosted, source-availa","content":"nitpickr is a self-hosted, source-available AI code reviewer focused on pull request review with model-agnostic design. Greptile is a SaaS platform focused on codebase-aware AI, offering code review as one of several API-driven features. nitpickr keeps your code on your own infrastructure, while Greptile processes code on their servers.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3374.66},{"type":"text","id":"tz9","name":"Does nitpickr index the entire codebase ","content":"Does nitpickr index the entire codebase like Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3614.45},{"type":"text","id":"tza","name":"nitpickr currently focuses on diff-first","content":"nitpickr currently focuses on diff-first analysis: it reviews changed files and hunks with surrounding context. Full codebase indexing and semantic analysis are on the roadmap. For most pull request reviews, diff-focused analysis with repository instructions produces high-quality results.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3659.49},{"type":"text","id":"tzb","name":"Can I use nitpickr without sending code ","content":"Can I use nitpickr without sending code to a third-party server?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3872.89},{"type":"text","id":"tzc","name":"Yes. nitpickr runs entirely on your infr","content":"Yes. nitpickr runs entirely on your infrastructure. Your code is sent only to the LLM provider you configure (such as OpenAI or a self-hosted model endpoint). With Greptile, your code is sent to their servers for indexing and analysis.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":3917.93},{"type":"text","id":"tzd","name":"How does the pricing model differ betwee","content":"How does the pricing model differ between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":4104.93},{"type":"text","id":"tze","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and hosting. Greptile offers usage-based pricing through API access. For teams running frequent reviews, nitpickr's bring-your-own-key model often results in lower total cost.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":4149.97}]}]}]},{"type":"ref","id":"rzz","ref":"f7c","name":"footer / mobile","x":0,"y":4896.36}]}]}],"x":9890,"y":0},{"type":"frame","id":"P128","name":"GH-39/A/docs/desktop/light","reusable":false,"theme":{"mode":"light"},"width":1440,"height":1402,"clip":true,"layout":"none","children":[{"type":"frame","id":"f127","name":"body","x":0,"y":0,"width":1440,"height":1402.36,"fill":[{"type":"gradient","gradientType":"radial","center":{"x":0,"y":0},"colors":[{"color":"$literal-DE6C301F","position":0},{"color":"$literal-00000000","position":0.26}]},{"type":"gradient","gradientType":"radial","center":{"x":1,"y":0},"colors":[{"color":"$literal-C3D7A12E","position":0},{"color":"$literal-00000000","position":0.24}]},{"type":"gradient","gradientType":"linear","rotation":180,"colors":[{"color":"$literal-FBF7F1","position":0},{"color":"$bg","position":0.42},{"color":"$literal-F2ECE2","position":1}]}],"layout":"none","children":[{"type":"frame","id":"f101","name":"a.skip-link","x":16,"y":-64,"width":140.13,"height":44,"fill":"$text","cornerRadius":"$rounded-full","layout":"none","children":[{"type":"text","id":"t100","name":"Skip to content","content":"Skip to content","fill":"$literal-FFFFFF","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","underline":true,"x":16,"y":12}],"layoutPosition":"absolute"},{"type":"frame","id":"f126","name":"div.site-shell","x":0,"y":0,"width":1440,"height":1402.36,"clip":true,"layout":"vertical","padding":[0,0,0,0],"children":[{"type":"ref","id":"r129","ref":"f10n","name":"header / desktop","x":0,"y":0},{"type":"frame","id":"f11t","name":"main","x":0,"y":83,"width":1440,"height":1139.97,"layout":"none","children":[{"type":"frame","id":"f11s","name":"section.section","x":0,"y":0,"width":1440,"height":1139.97,"layout":"none","children":[{"type":"frame","id":"f10r","name":"nav \"Breadcrumb\"","x":370,"y":88,"width":700,"height":23.22,"layout":"none","children":[{"type":"frame","id":"f10q","name"