","lineHeight":"$lineHeight-1_65","x":19.39,"y":1590.64},{"type":"text","id":"t149","name":"provider that exposes an OpenAI-compatib","content":"provider that exposes an OpenAI-compatible","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1617.03},{"type":"text","id":"t14a","name":"API. You can switch models at any time","content":"API. You can switch models at any time","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1643.43},{"type":"text","id":"t14b","name":"without changing your workflow.","content":"without changing your workflow.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1669.82},{"type":"text","id":"t14c","name":"CodeRabbit uses their own model selectio","content":"CodeRabbit uses their own model selection. You generally cannot bring your own API keys or choose a specific model version.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":335.72,"x":19.39,"y":1715.39},{"type":"text","id":"t14d","name":"Pricing","content":"Pricing","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":1825.9},{"type":"text","id":"t14e","name":"nitpickr has no subscription fee. You pa","content":"nitpickr has no subscription fee. You pay for","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1860.08},{"type":"text","id":"t14f","name":"your own LLM API usage and whatever host","cont