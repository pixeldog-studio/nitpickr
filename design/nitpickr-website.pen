ickr\ncorepack enable\npnpm install\n\n# Set your environment\ncp .env.example .env\n# Fill in OPENAI_API_KEY and OPENAI_MODEL\n\n# Run the evaluation\npnpm eval:reviews","fill":"$text","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_08","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":482.05,"x":20.19,"y":16.09}]},{"type":"text","id":"tbc","name":"The evaluation runner reports per-dimens","content":"The evaluation runner reports per-dimension scores, overall averages, and comparison tables when you test multiple models.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":628.13,"x":36.19,"y":2079.52},{"type":"text","id":"tbd","name":"Limitations","content":"Limitations","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":36.19,"y":2163.63},{"type":"text","id":"tbe","name":"The test corpus is small and focused on ","content":"The test corpus is small and focused on TypeScript and JavaScript. Results on other languages may differ.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":608.94,"x":55.38,"y":2197.82},{"type":"text","id":"tbf","name":"LLM outputs are non-deterministic. Runni","content":"LLM outputs are non-deterministic. Running the same benchmark twice may produce slightly different scores.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":608.94,"x":55.38,"y":2250.6},{"type":"text","id":"tbg","name":"Scores reflect the current review pipeli","content":"Scores reflect the current review p