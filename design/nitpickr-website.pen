g":"$letterSpacing--0_74","x":19.39,"y":2249.25},{"type":"text","id":"t19t","name":"Yes. nitpickr is model-agnostic. You set","content":"Yes. nitpickr is model-agnostic. You set the model through the","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2276.63},{"type":"frame","id":"f19v","name":"code","x":19.39,"y":2305.5,"width":113.75,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"t19u","name":"OPENAI_MODEL","content":"OPENAI_MODEL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"t19w","name":"environment variable and can use any Ope","content":"environment variable and can use any OpenAI-compatible","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":136.91,"y":2303.02},{"type":"text","id":"t19x","name":"API endpoint via","content":"API endpoint via","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":2329.41},{"type":"frame","id":"f19z","name":"code","x":141.59,"y":2331.89,"width":139.67,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"t19y","name":"OPENAI_BASE_URL","content":"OPENAI_BASE_URL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"t1a0","name":". This means you can use GPT-4, GPT-5-mi","content":". This means you can use GPT-4, GPT-5-mini,","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":