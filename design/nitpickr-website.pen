"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"t1rh","name":"Setup","content":"Setup","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_55","x":14.39,"y":22.19}]},{"type":"frame","id":"f1rk","name":"td","x":138.08,"y":642.13,"width":216.78,"height":69,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"t1rj","name":"Docker Compose + GitHub App","content":"Docker Compose + GitHub App","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":188.48,"x":14.4,"y":10.78}]},{"type":"frame","id":"f1rm","name":"td","x":354.86,"y":642.13,"width":186.36,"height":69,"stroke":"$line","strokeWidth":{"top":0,"right":0,"bottom":1,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"t1rl","name":"API integration or marketplace install","content":"API integration or marketplace install","fill":"$text","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-14_72","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_55","textGrowth":"fixed-width","width":158.06,"x":14.4,"y":10.78}]}]},{"type":"text","id":"t1ro","name":"Self-hosted vs SaaS","content":"Self-hosted vs SaaS","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":978.8},{"type":"text","id":"t1rp","name":"nitpickr runs on your own infrastructure","content":"nitpickr runs on your own infrastructure: a Docker Compose stack, a VPS, or Railway. Your source code is sent only to the LLM provider you configure. You control the deployment, secrets, and logs.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1033.71},{"type":"text","id":"t1rq","name":"Greptile is a cloud platform. It indexes","content":"Greptile is a cloud platform. It indexes your repositories and stores that index on their servers. This enables broader codebase understanding but means your code is processed and stored externally.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1132.07},{"type":"text","id":"t1rr","name":"Review approach","content":"Review approach","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":1242.57},{"type":"text","id":"t1rs","name":"nitpickr uses diff-first analysis: it re","content":"nitpickr uses diff-first analysis: it reviews changed files and hunks with surrounding context, repository instructions, and review memory. This keeps reviews fast and focused on the actual changes.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1276.75},{"type":"text","id":"t1rt","name":"Greptile indexes the entire codebase to ","content":"Greptile indexes the entire codebase to provide deeper context about how changes relate to the rest of the project. This can catch cross-file issues but requires external indexing.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1375.11},{"type":"text","id":"t1ru","name":"Model control","content":"Model control","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":1485.62},{"type":"text","id":"t1rv","name":"nitpickr is model-agnostic. Set","content":"nitpickr is model-agnostic. Set","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1519.8},{"type":"frame","id":"f1rx","name":"code","x":240.63,"y":1522.28,"width":113.75,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"t1rw","name":"OPENAI_MODEL","content":"OPENAI_MODEL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"t1ry","name":"and","content":"and","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":358.14,"y":1519.8},{"type":"frame","id":"f1s0","name":"code","x":388.84,"y":1522.28,"width":139.67,"height":22.44,"fill":"$literal-1F19130D","cornerRadius":"$rounded-5","layout":"none","children":[{"type":"text","id":"t1rz","name":"OPENAI_BASE_URL","content":"OPENAI_BASE_URL","fill":"$text-soft","fontFamily":"$font-ibm-plex-mono","fontSize":"$fontSize-14_4","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":5.03,"y":-0.66}]},{"type":"text","id":"t1s1","name":"to","content":"to","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":532.28,"y":1519.8},{"type":"text","id":"t1s2","name":"point at GPT-4, GPT-5-mini, Claude, Gemi","content":"point at GPT-4, GPT-5-mini, Claude, Gemini, or a self-hosted model. Switch","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1546.19},{"type":"text","id":"t1s3","name":"models without changing your workflow.","content":"models without changing your workflow.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":19.39,"y":1572.58},{"type":"text","id":"t1s4","name":"Greptile manages the model selection on ","content":"Greptile manages the model selection on their platform. You typically cannot bring your own API keys or choose a specific model version.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1618.16},{"type":"text","id":"t1s5","name":"Pricing","content":"Pricing","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","x":19.39,"y":1702.27},{"type":"text","id":"t1s6","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and whatever hosting you choose. Running locally with Docker Compose means you mainly pay for model API calls.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1736.46},{"type":"text","id":"t1s7","name":"Greptile offers usage-based pricing thro","content":"Greptile offers usage-based pricing through their API. Costs scale with the number of queries and the size of indexed repositories.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":1834.82},{"type":"text","id":"t1s8","name":"When to choose nitpickr","content":"When to choose nitpickr","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":1918.93},{"type":"text","id":"t1s9","name":"You want code to stay on your own infras","content":"You want code to stay on your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":1973.83},{"type":"text","id":"t1sa","name":"You want to choose and switch AI models ","content":"You want to choose and switch AI models freely","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2000.22},{"type":"text","id":"t1sb","name":"You want source-available software you c","content":"You want source-available software you can inspect","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2026.61},{"type":"text","id":"t1sc","name":"You prefer paying only for actual API us","content":"You prefer paying only for actual API usage","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2053},{"type":"text","id":"t1sd","name":"Pull request review is your primary use ","content":"Pull request review is your primary use case","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2079.39},{"type":"text","id":"t1se","name":"When to choose Greptile","content":"When to choose Greptile","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":2137.12},{"type":"text","id":"t1sf","name":"You need deep codebase understanding acr","content":"You need deep codebase understanding across all files","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2192.02},{"type":"text","id":"t1sg","name":"You want AI-powered search and Q&A beyon","content":"You want AI-powered search and Q&A beyond code review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2218.41},{"type":"text","id":"t1sh","name":"You prefer a managed API without running","content":"You prefer a managed API without running your own infrastructure","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2244.8},{"type":"text","id":"t1si","name":"You need the broadest possible context f","content":"You need the broadest possible context for each review","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":38.58,"y":2271.19},{"type":"text","id":"t1sj","name":"Frequently asked questions","content":"Frequently asked questions","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-21_6","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_86","textGrowth":"fixed-width","width":168.45,"x":19.39,"y":2328.91},{"type":"text","id":"t1sk","name":"What is the main difference between nitp","content":"What is the main difference between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":19.39,"y":2399.68},{"type":"text","id":"t1sl","name":"nitpickr is a self-hosted, source-availa","content":"nitpickr is a self-hosted, source-available AI code reviewer focused on pull request review with model-agnostic design. Greptile is a SaaS platform focused on codebase-aware AI, offering code review as one of several API-driven features. nitpickr keeps your code on your own infrastructure, while Greptile processes code on their servers.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":2427.07},{"type":"text","id":"t1sm","name":"Does nitpickr index the entire codebase ","content":"Does nitpickr index the entire codebase like Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":19.39,"y":2587.68},{"type":"text","id":"t1sn","name":"nitpickr currently focuses on diff-first","content":"nitpickr currently focuses on diff-first analysis: it reviews changed files and hunks with surrounding context. Full codebase indexing and semantic analysis are on the roadmap. For most pull request reviews, diff-focused analysis with repository instructions produces high-quality results.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":2615.07},{"type":"text","id":"t1so","name":"Can I use nitpickr without sending code ","content":"Can I use nitpickr without sending code to a third-party server?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":19.39,"y":2749.29},{"type":"text","id":"t1sp","name":"Yes. nitpickr runs entirely on your infr","content":"Yes. nitpickr runs entirely on your infrastructure. Your code is sent only to the LLM provider you configure (such as OpenAI or a self-hosted model endpoint). With Greptile, your code is sent to their servers for indexing and analysis.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":2776.68},{"type":"text","id":"t1sq","name":"How does the pricing model differ betwee","content":"How does the pricing model differ between nitpickr and Greptile?","fill":"$text","fontFamily":"$font-space-grotesk","fontSize":"$fontSize-18_4","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-0_96","letterSpacing":"$letterSpacing--0_74","x":19.39,"y":2910.9},{"type":"text","id":"t1sr","name":"nitpickr has no subscription or per-seat","content":"nitpickr has no subscription or per-seat fees. You pay for your own LLM API usage and hosting. Greptile offers usage-based pricing through API access. For teams running frequent reviews, nitpickr's bring-your-own-key model often results in lower total cost.","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":541.72,"x":19.39,"y":2938.28}]}]}]},{"type":"ref","id":"r1tb","ref":"f9y","name":"footer / small","x":0,"y":3664.3},{"type":"ref","id":"r1tc","ref":"f79","name":"header / small","x":0,"y":0,"layoutPosition":"absolute"}]},{"type":"frame","id":"f1ov","name":"a.skip-link","x":16,"y":-64,"width":140.13,"height":44,"fill":"$text","cornerRadius":"$rounded-full","layout":"none","children":[{"type":"text","id":"t1ou","name":"Skip to content","content":"Skip to content","fill":"$literal-F