","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_65","x":55.38,"y":463.63},{"type":"text","id":"t86","name":"— are the comments clear enough for the ","content":"— are the comments clear enough for the author to act on without extra","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":153.38,"y":463.63},{"type":"text","id":"t87","name":"context?","content":"context?","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":55.38,"y":490.02},{"type":"text","id":"t88","name":"Line accuracy","content":"Line accuracy","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_65","x":55.38,"y":516.41},{"type":"text","id":"t89","name":"— do inline comments point to the correc","content":"— do inline comments point to the correct lines in the diff?","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":160.34,"y":516.41},{"type":"text","id":"t8a","name":"Summary quality","content":"Summary quality","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_65","x":55.38,"y":542.8},{"type":"text","id":"t8b","name":"— does the review summary accurately des","content":"— does the review summary accurately describe the change and","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":185.7,"y":542.8},{"type":"text","id":"t8c","name":"key concerns?","content":"key concerns?","fill":"$text-soft","fontFamily":"$font-ibm-plex-sans","fontSize":"$fontSize-16","fon