{
  "name": "nitpickr",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "description": "Self-hosted AI code review service for GitHub pull requests.",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "site:build": "node scripts/build-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm site:build",
    "test:watch": "vitest",
    "dev:api": "tsx --import ./src/observability/instrument.ts src/api/index.ts",
    "dev:worker": "tsx --import ./src/observability/instrument.ts src/worker/index.ts",
    "start:api": "node --import ./dist/src/observability/instrument.js dist/src/api/index.js",
    "start:worker": "node --import ./dist/src/observability/instrument.js dist/src/worker/index.js",
    "migrate": "tsx src/cli/index.ts migrate",
    "cli": "tsx src/cli/index.ts",
    "eval:reviews": "tsx src/cli/index.ts eval:reviews"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@sentry/node": "^11.4.0",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
