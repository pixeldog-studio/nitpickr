# Sentry (optional — leave unset to disable; SDK no-ops without a DSN)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Core runtime
DATABASE_URL=postgres://nitpickr:nitpickr@db:5432/nitpickr
NITPICKR_BASE_URL=https://your-public-host
NITPICKR_WEBHOOK_URL=https://your-public-host/webhooks/github
NITPICKR_SECRET_KEY=replace-with-a-long-random-secret

# Local model server (Ollama, llama-server, LM Studio, vLLM — anything that
# speaks /v1/chat/completions). From Docker Compose, reach a model server on
# the host through host.docker.internal, as below. When unset, nitpickr uses
# http://localhost:11434/v1 (Ollama on the same machine, outside Docker).
NITPICKR_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# Model name as your server knows it (for Ollama, the tag from `ollama list`).
NITPICKR_REVIEW_MODEL=qwen3.8:27b-nvfp4
# Chat model for the memory classifier (small prompts). Defaults to the review model.
# NITPICKR_MEMORY_MODEL=
# Bearer token, only for servers that require one. Ollama needs none.
# NITPICKR_MODEL_API_KEY=
# Sent as `reasoning_effort` (none|minimal|low|medium|high); `none` turns off
# thinking on Ollama thinking models. Leave unset if your model ignores it.
# NITPICKR_MODEL_REASONING_EFFORT=none
# Per-request timeout for every model call (default 300000 = 5 min). Local
# models on long PRs can need much longer.
NITPICKR_MODEL_REQUEST_TIMEOUT_MS=1800000
# Max model requests in flight for one review (chunk fan-out). Default 4; use 1
# for a single local model server.
NITPICKR_MODEL_MAX_CONCURRENT_REQUESTS=1
# Total prompt characters (patch + file content) packed per review chunk.
# Lower this for models with small context windows or slow prefill. Default 200000.
# NITPICKR_REVIEW_CHUNK_MAX_TOTAL_CHARS=200000

# Memory embeddings run in-process (transformers.js on CPU), not on the model
# server, so they never evict the review model. The Docker image bakes the
# default model in. Set to "off" to rank memories by keyword + recency only.
# NITPICKR_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# Vector width of the embedding model (nomic-embed-text-v1.5 = 768). Changing it
# re-shapes the memories.embedding column on the next migrate and clears stored vectors.
# NITPICKR_EMBEDDING_DIMENSIONS=768

# GitHub App
GITHUB_APP_ID=<GITHUB_APP_ID>
GITHUB_API_BASE_URL=https://api.github.com
# Comma-separated mention handles without '@'. Usually your GitHub App name.
GITHUB_BOT_LOGINS=nitpickr,getnitpickr
# Store the private key in your secret manager. Do not commit real keys.
# If you must use a single-line env var, use '\n' escapes for newlines.
GITHUB_PRIVATE_KEY=<GITHUB_APP_PRIVATE_KEY>
# Generate a random secret and keep it out of source control.
GITHUB_WEBHOOK_SECRET=<GITHUB_WEBHOOK_SECRET>

# Runtime tuning
PORT=3000
NITPICKR_LOG_LEVEL=info
NITPICKR_WORKER_CONCURRENCY=1
NITPICKR_WORKER_POLL_INTERVAL_MS=5000
NITPICKR_JOB_STALE_AFTER_MS=120000
NITPICKR_WORKER_HEARTBEAT_INTERVAL_MS=5000
NITPICKR_READY_WORKER_STALE_AFTER_MS=15000

# Optional limits
# NITPICKR_REPOSITORY_ALLOWLIST=owner/repo-a,owner/repo-b
# NITPICKR_PROMPT_OPTIMIZATION_MODE=balanced
# DISCORD_WEBHOOK_URL=
